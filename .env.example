# URL API, доступен и в браузере, и на сервере
# Для локальной разработки можно оставить пустым — форма отправит на /api/contact
NEXT_PUBLIC_API_URL=

# Unisender Go — Web API (https://godocs.unisender.ru/web-api-ref)
# Ключ: кабинет Unisender Go → Настройки → API-ключ
UNISENDER_API_KEY=
# Опционально, по умолчанию goapi.unisender.ru
# UNISENDER_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1/email/send.json

# Отправитель должен быть на подтверждённом домене отправки (dealercms.ru)
MAIL_FROM=noreply@dealercms.ru
MAIL_FROM_NAME=DealerCMS
# Куда падают заявки с формы
MAIL_TO=fydorzbinyakov@gmail.com
