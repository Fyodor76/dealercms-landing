# URL API, доступен и в браузере, и на сервере
# Для локальной разработки можно оставить пустым — форма отправит на /api/contact
NEXT_PUBLIC_API_URL=

# Настройки SMTP из панели Beget: Почта -> нужный домен -> почтовый ящик
# https://beget.com/ru/kb/faq/mail
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@dealercms.ru
SMTP_PASSWORD=
SMTP_FROM=noreply@dealercms.ru
SMTP_TO=info@dealercms.ru
